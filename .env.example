# Copy to .env. Everything has a local default except the API keys.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
# Orchestrator -> subagent graph (see docs/agent-orchestration.md)
ORCHESTRATOR_MAX_DEPTH=2
ORCHESTRATOR_MAX_SUBAGENTS=5
SUBAGENT_EFFORT=low
SUBAGENT_MAX_ITERATIONS=8
SIMPLE_MODE=true

# --- Embeddings: "fake" (no key, testing only) or "voyage" ---------------
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# --- Auth: "dev" trusts X-Dev-* headers; "clerk" verifies Clerk JWTs -----
AUTH_MODE=dev
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=
INTERNAL_TOKEN=dev-internal-token
# Shared only by agent and financials. Replace with a random secret outside local dev.
USAGE_WRITER_TOKEN=dev-usage-writer-token

# --- Object storage (MinIO locally) --------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Edge (Traefik) -----------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40

# Optional tracing: start the observability profile and use http://otel-collector:4317 in Docker.
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AGENT_MAX_PARALLEL=4
AGENT_MAX_TOTAL_AGENTS=12

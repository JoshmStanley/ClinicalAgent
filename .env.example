# Copy to .env. Everything has a local default except the API keys.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium

# --- Embeddings: "fake" (no key, testing only) or "voyage" ---------------
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# --- Auth: "dev" trusts X-Dev-* headers; "clerk" verifies Clerk JWTs -----
AUTH_MODE=dev
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=
INTERNAL_TOKEN=dev-internal-token
# Shared only by agent and financials. Replace with a random secret outside local dev.
USAGE_WRITER_TOKEN=dev-usage-writer-token

# --- Object storage (MinIO locally) --------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
